<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>MouseWithoutBorders.UnitTests</AssemblyName>
    <RootNamespace>MouseWithoutBorders.UnitTests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="MSTest" Version="3.8.3" />
    <ProjectReference Include="..\App\MouseWithoutBorders.csproj" />
    <EmbeddedResource Include="Core\Logger.PrivateDump.expected.txt;Core\Logger.PrivateDump.original.txt" />
  </ItemGroup>
</Project>
